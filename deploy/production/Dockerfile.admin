FROM node:22-alpine AS build
WORKDIR /app/src/frontend/web-admin
RUN npm install -g pnpm@10.18.3

COPY src/frontend/web-admin/package.json src/frontend/web-admin/pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile

COPY src/frontend/web-admin ./
ARG UMI_APP_API_BASE_URL=
ENV UMI_APP_API_BASE_URL=$UMI_APP_API_BASE_URL
RUN rm -f .env.local
RUN pnpm build

FROM nginx:1.27-alpine AS runtime
COPY src/frontend/web-admin/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/src/frontend/web-admin/dist /usr/share/nginx/html
EXPOSE 80
